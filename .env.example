# Local Docker Desktop / Linux amd64. Set WEB_BIND_ADDRESS=0.0.0.0 for LAN access.
WEB_BIND_ADDRESS=127.0.0.1
WEB_FRONTEND_PORT=19440
AGENT_BACKEND_PORT=19441
SPEECH_BACKEND_PORT=19442
VITE_DEV_PORT=19443
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:6.0
DOTNET_ASPNET_IMAGE=mcr.microsoft.com/dotnet/aspnet:6.0
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.27-alpine
# demo works without credentials. Set model for real tool-calling chat.
AGENT_MODE=demo
SK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3
SK_API_KEY=
SK_MODEL_ID=
SK_TIMEOUT_MS=120000
SK_MAX_OUTPUT_TOKENS=1600
SK_TEMPERATURE=0.2
AGENT_HISTORY_MAX_ROUNDS=6
AGENT_SUMMARY_TRIGGER_ROUNDS=8
AGENT_SUMMARY_KEEP_RECENT_ROUNDS=4
AGENT_SUMMARY_MAX_OUTPUT_TOKENS=400
ARK_SPEECH_API_KEY=
ARK_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
ARK_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
ARK_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
ARK_TTS_RESOURCE_ID=seed-tts-2.0
ARK_TTS_SPEAKER=
ARK_ASR_END_WINDOW_SIZE=800
ARK_ASR_ENABLE_NONSTREAM=true
ARK_ASR_LANGUAGE=zh-CN
ARK_TTS_SAMPLE_RATE=24000
ARK_TTS_FORMAT=pcm
